# ── Shell ──
command = /usr/bin/zsh
shell-integration = zsh

# ── Font ──
font-family = IosevkaTerm Nerd Font
font-family-bold = IosevkaTerm Nerd Font Bold
font-family-italic = IosevkaTerm Nerd Font Italic
font-family-bold-italic = IosevkaTerm Nerd Font Bold Italic
font-size = 10

# ── Window ──
background-opacity = 0.70
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
confirm-close-surface = false

# ── Cursor ──
cursor-style = bar

# ── Colors (regenerated by theme-switch.sh, follows the rice like kitty) ──
config-file = theme.conf

# ── Keybinds ──
# Ghostty already ships kitty-equivalent defaults: alt+1..9 = goto tab,
# ctrl+shift+t = new tab, ctrl+tab / ctrl+shift+tab = cycle tabs,
# ctrl+= / ctrl+- / ctrl+0 = font size. These few match remaining kitty muscle memory.
keybind = ctrl+shift+enter=new_window
keybind = ctrl+shift+w=close_surface
